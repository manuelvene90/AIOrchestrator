<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stand-in for the `claude` CLI that the contract tests and the PrintRunner tests drive.
       It accepts the flags the bridge sends, answers from a scenario file, and prints the result
       JSON in the shape measured against Claude Code 2.1.261 (see README.md). Cross-platform, one
       binary: it must run wherever the test suite runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FakeClaude</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
