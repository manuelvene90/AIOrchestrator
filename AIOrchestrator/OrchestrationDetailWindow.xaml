<Window x:Class="AIOrchestrator.OrchestrationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AIOrchestrator.Views"
        Title="Orchestration" Height="900" Width="1440"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: identity -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold"/>
                <TextBlock x:Name="OrchIdText" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="12,9,0,0"/>
                <TextBlock x:Name="ClosedText" Foreground="{StaticResource StateClosed}" FontSize="12" FontWeight="SemiBold" Margin="12,9,0,0"/>
            </StackPanel>
            <TextBlock x:Name="RepoText" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- STAT STRIP -->
        <ItemsControl x:Name="StatsItemsControl" Grid.Row="1" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type views:StatChipView}">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="5" Padding="10,6" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                            <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- BODY: ledger | activity | members -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- PLAN.md ledger -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="TASK LEDGER (PLAN.md)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="LedgerCountsText" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                   HorizontalAlignment="Right" Margin="0,11,12,0"/>
                    </DockPanel>
                    <TextBlock x:Name="NoLedgerText" DockPanel.Dock="Top" Margin="12,4,12,0" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="No PLAN.md yet. The supervisor writes one once you approve a direction; the progress bar and /progress read it."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,4,8">
                        <ItemsControl x:Name="PlanItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:PlanLineView}">
                                    <StackPanel Orientation="Horizontal" Margin="4,2" Opacity="{Binding LineOpacity}">
                                        <TextBlock Text="{Binding MarkerGlyph}" Foreground="{Binding MarkerBrush}" FontFamily="Consolas"
                                                   FontSize="12" FontWeight="Bold" Width="20" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding TaskText}" FontSize="11" FontWeight="{Binding TaskWeight}"
                                                   TextWrapping="Wrap" MaxWidth="300"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Merged activity feed -->
            <Border Grid.Column="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ACTIVITY — OWNER CHANNEL + EVERY IMPLEMENTER SPOKE (newest first)" Style="{StaticResource SectionHeader}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,4,8">
                        <ItemsControl x:Name="ActivityItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:ActivityRowView}">
                                    <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="8,6" Margin="4,3">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding AuthorBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AuthorLabel}" Foreground="{Binding AuthorBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="8,1,0,0"/>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="8,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subject}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="14,2,0,0"/>
                                            <TextBlock Text="{Binding BodyPreview}" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="14,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Members -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SESSIONS" Style="{StaticResource SectionHeader}"/>

                    <!-- GIT GROUND TRUTH: what the trees actually contain, not what agents claim -->
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" MaxHeight="260">
                        <TextBlock DockPanel.Dock="Top" Text="GIT — GROUND TRUTH" Style="{StaticResource SectionHeader}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,4,8">
                            <ItemsControl x:Name="GitItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:GitTreeView}">
                                        <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="8,6" Margin="4,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="10" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding CommitsText}" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                                           FontFamily="Consolas" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,4,8">
                        <ItemsControl x:Name="MembersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:MemberRowView}">
                                    <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="8,6" Margin="4,3" Opacity="{Binding RowOpacity}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding RoleBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MemberLabel}" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <Button Content="🖥 Show" FontSize="10" Padding="6,2" HorizontalAlignment="Right"
                                                        Tag="{Binding}" Click="ShowSessionButton_Click"
                                                        Visibility="{Binding ShowButtonVisibility}"/>
                                            </DockPanel>
                                            <Border Background="{Binding StateBrush}" CornerRadius="8" Padding="7,1" HorizontalAlignment="Left" Margin="14,4,0,0">
                                                <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="#101318"/>
                                            </Border>
                                            <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="14,4,0,0"/>
                                            <TextBlock Text="{Binding LastActivityText}" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="14,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="RefreshedText" Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddImplementerButton" Content="＋ Implementer" Click="AddImplementerButton_Click" Margin="0,0,8,0"
                        ToolTip="Spawn another implementer in this orchestration"/>
                <Button x:Name="CloseOrchestrationButton" Content="✕ Close orchestration" Click="CloseOrchestrationButton_Click" Margin="0,0,8,0"
                        ToolTip="End every session, delete the Telegram topic, keep the folder as audit trail"/>
                <Button Content="📂 Open folder" Click="OpenFolderButton_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Width="90" Click="CloseButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
