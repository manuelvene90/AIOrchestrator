<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIOrchestratorCoreLib\AIOrchestratorCoreLib.csproj" />
    <!-- Suite LoggingLib was referenced in v1 for its ListBoxLoggerSimple log panel, then retired:
         the control is hard-designed for light theme (white root, pastel per-tag rows) and cannot
         be dark-themed from outside. The app now has its own dark log view (Views/LogRowView +
         MainWindow's ActivityLogListBox). No suite references remain — the repo builds standalone. -->
  </ItemGroup>

</Project>
