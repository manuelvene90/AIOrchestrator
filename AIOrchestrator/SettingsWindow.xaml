<Window x:Class="AIOrchestrator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AIOrchestrator.Views"
        xmlns:core="clr-namespace:AIOrchestratorCoreLib.Configuration.SettingsPresentation;assembly=AIOrchestratorCoreLib"
        Title="AI Orchestrator — Settings" Height="720" Width="860" MinWidth="640" MinHeight="420"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <!--
        GENERIC OVER THE CATALOGUE (plan 04 Task 9). One tab per category, rows from CoreLib's
        SettingsRow_Builder, each row's control chosen by CoreLib's SettingEditor_Factory and looked up here by
        its SettingEditorKinds value. This file holds layout and binding only: every word a row shows and every
        value an edit writes comes from CoreLib, where the suite can test it. Immediate-apply per row (D5): there
        is no Cancel — a change is written the moment it is made, exactly as the phone and the web page write it.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:SettingRowTemplate_Selector x:Key="EditorSelector"/>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="12,6" Margin="0,0,2,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgPanel}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgCard}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentImplementer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default ComboBox chrome is light; its words are drawn dark so they stay readable on it. -->
        <Style x:Key="WordCombo" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#1B1E24"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="26"/>
        </Style>

        <!-- ── One template per SettingEditorKinds value (the selector looks them up by the value itself) ── -->

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.Toggle}">
            <CheckBox IsChecked="{Binding IsOn, Mode=OneWay}" Click="Toggle_Click" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.Choice}">
            <ComboBox Style="{StaticResource WordCombo}" HorizontalAlignment="Left"
                      ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer, Mode=OneWay}"
                      SelectionChanged="Choice_SelectionChanged"/>
        </DataTemplate>

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.Number}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource SmallButton}" Click="ApplyText_Click"/>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Box_KeyDown" FontFamily="Consolas"/>
                </DockPanel>
                <TextBlock Text="{Binding RangeHint}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.Text}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource SmallButton}" Click="ApplyText_Click"/>
                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Box_KeyDown" FontFamily="Consolas"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListItemsTemplate">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,3">
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Remove" Style="{StaticResource SmallButton}" Click="RemoveItem_Click"/>
                            <Button DockPanel.Dock="Right" Content="↓" ToolTip="Move down" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanMoveDown}" Click="MoveItemDown_Click"/>
                            <Button DockPanel.Dock="Right" Content="↑" ToolTip="Move up" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanMoveUp}" Click="MoveItemUp_Click"/>
                            <TextBlock Text="{Binding Caption}" FontFamily="Consolas" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.WordPicker}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ListItemsTemplate}"/>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SmallButton}" Click="AddOffer_Click"/>
                    <ComboBox Style="{StaticResource WordCombo}" ItemsSource="{Binding RemainingOffers}"
                              SelectedItem="{Binding PickedOffer, Mode=TwoWay}"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.FreeTextList}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ListItemsTemplate}"/>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SmallButton}" Click="AddWord_Click"/>
                    <TextBox Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewWord_KeyDown" FontFamily="Consolas"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="{x:Static core:SettingEditorKinds.ReadOnly}">
            <TextBlock Text="Shown here only — its description says where it is changed." Style="{StaticResource Hint}"/>
        </DataTemplate>

        <!-- ── One row: who it is on the left, what it reads and its control on the right ── -->

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type views:SettingRowView}">
            <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayValue}" FontFamily="Consolas" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,3,0,0">
                            <Border Background="#333A47" CornerRadius="3" Padding="5,1" Margin="0,0,6,2">
                                <TextBlock Text="{Binding OriginLabel}" FontSize="10"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding RestartLabel}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding SessionNote}" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SessionNote}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource EditorSelector}"
                                        Margin="0,6,0,0" Focusable="False"/>

                        <Button Content="Reset" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"
                                ToolTip="Remove this value from config.json so the preset or shipped value applies again"
                                Visibility="{Binding CanReset, Converter={StaticResource BoolToVisibility}}"
                                Click="Reset_Click"/>

                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentReviewer}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoteIsRefusal}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StateBlocked}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── One catalogue tab: its rows, or the builder's own sentence when it has none (Kit) ── -->

        <DataTemplate x:Key="SectionTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,8,0">
                <StackPanel>
                    <TextBlock Text="{x:Static core:SettingsRow_Builder.EMPTY_SECTION_NOTE}" Margin="2,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=RowsList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="RowsList" ItemsSource="{Binding}" ItemTemplate="{StaticResource RowTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header: the active preset is named, never offered (D13). -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PresetText" Margin="12,0,0,0" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"
                       Text="Every change is saved the moment you make it — the same way a tap on the phone or the web page saves it. The bot token is the one exception: it has its own Save."/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Click="CloseButton_Click"/>
        </DockPanel>

        <!-- Connection first; the catalogue tabs are added after it, in catalogue order, by the code-behind. -->
        <TabControl x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,8,0">
                    <StackPanel>
                        <!-- D11: the TOKEN is hand-written (it is deliberately not a catalogue row), and saved on its own. -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Telegram bot token" FontWeight="SemiBold"/>
                                <TextBlock Text="From @BotFather. Kept in secrets.json, never in config.json and never in any settings list. Read when the app starts: restart the app after saving a new one."
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Save token" Margin="8,0,0,0" Click="SaveTokenButton_Click"/>
                                    <TextBox x:Name="BotTokenTextBox" FontFamily="Consolas"/>
                                </DockPanel>
                                <TextBlock x:Name="TokenNoteText" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- D11: the two ids ARE catalogue rows, drawn by the same template as every other tab. -->
                        <ItemsControl x:Name="ConnectionRowsList" ItemTemplate="{StaticResource RowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
