<Window x:Class="AIOrchestrator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Orchestrator — Settings" Height="490" Width="520"
        Background="{StaticResource BgWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="TELEGRAM" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

        <TextBlock Text="Bot token (from @BotFather)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,2"/>
        <TextBox x:Name="BotTokenTextBox"/>

        <TextBlock Text="Supergroup chat id (-100…)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,2"/>
        <TextBox x:Name="ChatIdTextBox"/>

        <TextBlock Text="Your Telegram user id" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,2"/>
        <TextBox x:Name="OwnerIdTextBox"/>

        <TextBlock Text="MODELS (empty = your Claude Code default)" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Supervisors" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="SupervisorModelTextBox"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                <TextBlock Text="Implementers" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="ImplementerModelTextBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="General supervisor" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                <TextBox x:Name="GeneralModelTextBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="LANGUAGE" Style="{StaticResource SectionHeader}" Margin="0,14,0,6"/>

        <CheckBox x:Name="ItalianLayerCheckBox" Content="Italian layer on Telegram" FontSize="12"
                  Foreground="{StaticResource TextSecondary}"/>
        <TextBlock Text="You read/write Italian on Telegram; sessions and channels stay 100% English (messages are translated in both directions, technical terms kept in English). Applies live."
                   Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="22,2,0,0"/>

        <TextBlock x:Name="RestartNoteText" Text="Telegram and model changes apply to sessions spawned AFTER saving; Telegram bridge changes need an app restart."
                   Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="90" Click="SaveButton_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="90" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
